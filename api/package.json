{
  "name": "@ever-traduora/api",
  "version": "0.23.0",
  "license": "AGPL-3.0-only",
  "homepage": "https://traduora.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ever-co/ever-traduora.git"
  },
  "bugs": {
    "url": "https://github.com/ever-co/ever-traduora/issues"
  },
  "private": true,
  "author": {
    "name": "Ever Co. LTD",
    "email": "ever@ever.co",
    "url": "https://ever.co"
  },
  "scripts": {
    "fmt": "prettier --write \"src/**/*.ts\"",
    "start": "cross-env TR_PORT=3000 TR_DB_TYPE=mysql TR_DB_HOST=localhost TR_DB_PORT=3306 TR_DB_USER=root TR_DB_DATABASE=traduora TR_MAIL_DEBUG=true TR_CORS_ENABLED=true nodemon",
    "build": "tsc",
    "build:prod": "tsc",
    "clean": "rimraf ../dist/src ../dist/test",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=3000 NODE_ENV=test jest --watchAll=false --maxWorkers=2",
    "test:watch": "cross-env NODE_ENV=test TR_ACCESS_LOGS_ENABLED=false jest --watch",
    "test:e2e": "cross-env NODE_ENV=e2e TR_DEFAULT_PROJECT_PLAN=default TR_ACCESS_LOGS_ENABLED=false TR_DB_TYPE=mysql TR_DB_HOST=localhost TR_DB_PORT=3306 TR_DB_USER=root TR_DB_DATABASE=tr_e2e jest --config ./test/jest-e2e.json --runInBand --verbose --detectOpenHandles --forceExit",
    "test:ci": "pnpm test && pnpm test:e2e",
    "typeorm": "ts-node node_modules/.bin/typeorm",
    "seed": "cross-env TR_SEED_DATA=true ts-node -r tsconfig-paths/register src/seeds/seed-cli.ts",
    "seed:default": "cross-env TR_SEED_DATA=true TR_DEFAULT_SEED_ONLY=true ts-node -r tsconfig-paths/register src/seeds/seed-cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^5.1.1",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv": "^5.5.3",
    "csv-parse": "^4.16.3",
    "csv-stringify": "^6.0.5",
    "dotenv": "^16.4.7",
    "generate-password": "^1.6.1",
    "gettext-parser": "^4.0.4",
    "ioredis": "^5.6.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.0",
    "node-native2ascii": "^0.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.14.1",
    "php-array-parser": "^1.0.1",
    "properties": "^1.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.3.0",
    "strings-file": "^0.0.5",
    "swagger-ui-express": "^4.2.0",
    "typeorm": "^0.3.26",
    "xliff": "^5.6.2",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.6.5",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "semver-regex": "^4.0.5",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "testTimeout": 30000,
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22"
  },
  "snyk": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt"
    ]
  }
}
