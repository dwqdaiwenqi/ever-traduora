{
  "name": "ever-traduora",
  "version": "0.23.0",
  "description": "Ever® Traduora - Open Translation Management Platform",
  "license": "AGPL-3.0-only",
  "homepage": "https://traduora.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ever-co/ever-traduora.git"
  },
  "bugs": {
    "url": "https://github.com/ever-co/ever-traduora/issues"
  },
  "private": true,
  "author": {
    "name": "Ever Co. LTD",
    "email": "ever@ever.co",
    "url": "https://ever.co"
  },
  "scripts": {
    "prepare:husky": "npx husky install .husky",
    "fmt": "prettier --write --list-different \"**/*.ts\"",
    "check-fmt": "prettier --check \"**/*.ts\"",
    "bootstrap": "pnpm install",
    "build": "concurrently --raw \"pnpm build:api\" \"pnpm build:webapp\"",
    "build:lerna": "pnpm exec lerna run --parallel build",
    "build:api": "cross-env pnpm --dir ./api build",
    "build:webapp": "cross-env pnpm --dir ./webapp build",
    "start:web": "cross-env pnpm --dir ./webapp start",
    "start:api": "cross-env pnpm --dir ./api start",
    "commit": "git-cz",
    "commit:lint": "commitlint -E HUSKY_GIT_PARAMS",
    "semantic-release": "semantic-release",
    "seed": "cross-env pnpm --dir ./api seed",
    "seed:default": "cross-env pnpm --dir ./api seed:default"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/config-lerna-scopes": "^19.7.0",
    "@commitlint/travis-cli": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "cloc": "^2.4.0-cloc",
    "codelyzer": "^6.0.2",
    "commitizen": "^4.3.1",
    "concurrently": "^9.1.2",
    "conventional-changelog": "^6.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lerna": "^8.2.1",
    "lerna-changelog": "^2.2.0",
    "prettier": "^3.5.3",
    "prettier-tslint": "^0.4.2",
    "pretty-quick": "^4.1.1",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.3",
    "snyk": "^1.1296.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "pretty-quick --no-verify --staged"
    }
  },
  "lint-staged": {},
  "release": {
    "verifyConditions": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ],
    "prepare": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git"
    ],
    "publish": [
      "@semantic-release/github"
    ],
    "generateNotes": {
      "preset": "angular"
    },
    "npmPublish": false
  },
  "workspaces": {
    "packages": [
      "webapp",
      "api"
    ],
    "nohoist": [
      "**/@types/jasmine",
      "**/@types/jasminewd2",
      "**/@angular*/**",
      "**/@ngtools/**"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "snyk": true,
  "resolutions": {
    "browserslist": "^4.28.0",
    "caniuse-lite": "^1.0.30001805"
  }
}
